@startuml Classes
title Diagrama de Classes - Bucho-Cheio
skinparam linetype ortho
left to right direction

' ======================
' Classes Principais
' ======================
class Restaurante {
    - cnpj: String
    - nome: String
    - email: String
    - endereco: String
    - telefone: String
    - horarioAbertura: String
    - horarioFechamento: String
    + cadastraRestaurante(): void
    + atualizaCardapio(): void
    + cadastraHorario(): void
}

class Relatorio {
    - dataGeracao: Date
    - tipoRelatorio: String
    + gerarRelatorio(): void
}

class Usuario {
    - nome: String
    - email: String
    - senha: String
    + login(): boolean
    + consultaRestaurantes(): List<Restaurante>
    + avaliaRestaurante(): void
}

class Avaliacao {
    - nota: int
    - comentario: String
    - data: Date
    + registrarAvaliacao(): void
}

class Prato {
    - nome: String
    - preco: float
    - descricao: String
    - quantidadeDisponivel: int
    + atualizaPrato(): void
}

' ======================
' Relacionamentos
' ======================
Usuario "1" -u- "0..*" Avaliacao : realiza
Restaurante "1" -- "0..*" Avaliacao : recebe

Restaurante "1" -- "0..*" Prato : possui

Relatorio "1" -u- "0..*" Restaurante : inclui
Usuario "1" -u- "0..*" Relatorio : consulta

@enduml
